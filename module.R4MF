# R4OS 0.58.35 protocol project manifest.
R4OS_MODULE_MANIFEST=2
KIND=R4P
NAME=USBSCSI
VERSION=0.1.1
LANGUAGE=Zig
SOURCE=src/main.zig
TARGET=/R4OS/PROTOCOLS/USBSCSI.R4P
